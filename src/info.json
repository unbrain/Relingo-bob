{
  "identifier": "com.unbrain.bob.relingo",
  "version": "0.0.4",
  "category": "translate",
  "name": "Relingo Bob",
  "summary": "Bob 与 Relingo 联动：查词同步生词本/掌握状态、英英释义与词源，支持 Relingo 多引擎及自定义 LLM 句子翻译",
  "icon": "",
  "author": "unbrain <marsorsun@gmail.com>",
  "homepage": "https://github.com/unbrain/Relingo-bob",
  "appcast": "https://raw.githubusercontent.com/unbrain/Relingo-bob/main/appcast.json",
  "minBobVersion": "1.8.0",
  "options": [
    {
      "identifier": "wordModel",
      "type": "menu",
      "title": "查词模式",
      "defaultValue": "1",
      "menuValues": [
        {
          "title": "Relingo 全词本查询",
          "value": "1"
        },
        {
          "title": "Relingo 个人词本查询",
          "value": "0"
        }
      ],
      "desc": "个人词本仅查个人添加的词本（需登录）；未收录词自动回落句子翻译。"
    },
    {
      "identifier": "additionalDisplay",
      "type": "menu",
      "title": "额外显示",
      "defaultValue": "2",
      "menuValues": [
        {
          "title": "完整显示（词频/掌握 + 英英释义/词源）",
          "value": "2"
        },
        {
          "title": "仅显示词频/掌握",
          "value": "1"
        },
        {
          "title": "都不显示",
          "value": "0"
        }
      ],
      "desc": "控制词典卡片附加区域显示内容。"
    },
    {
      "identifier": "variant",
      "type": "menu",
      "title": "显示相关词汇",
      "defaultValue": "1",
      "menuValues": [
        {
          "title": "显示",
          "value": "1"
        },
        {
          "title": "不显示",
          "value": "0"
        }
      ],
      "desc": "显示单词的复数、过去式等词形变体。"
    },
    {
      "identifier": "translationEngine",
      "type": "menu",
      "title": "翻译引擎",
      "defaultValue": "google",
      "menuValues": [
        {
          "title": "Google（Relingo 免费默认）",
          "value": "google"
        },
        {
          "title": "OpenAI（Relingo Credits）",
          "value": "openai"
        },
        {
          "title": "DeepL（Relingo Credits）",
          "value": "deepl"
        },
        {
          "title": "DeepSeek（Relingo Credits）",
          "value": "deepseek"
        },
        {
          "title": "Claude（Relingo Credits）",
          "value": "claude"
        },
        {
          "title": "Gemini（Relingo Credits）",
          "value": "gemini"
        },
        {
          "title": "小牛翻译 Niu（Relingo）",
          "value": "niu"
        },
        {
          "title": "MyMemory 免费直连（免登录/免 Key）",
          "value": "mymemory"
        },
        {
          "title": "自定义 OpenAI 兼容 LLM",
          "value": "custom-llm"
        }
      ],
      "desc": "Google 为 Relingo 免费默认；OpenAI/DeepL/DeepSeek/Claude/Gemini 需 Credits。"
    },
    {
      "identifier": "fallbackEngine",
      "type": "menu",
      "title": "兜底翻译引擎",
      "defaultValue": "mymemory",
      "menuValues": [
        {
          "title": "MyMemory 免费直连",
          "value": "mymemory"
        },
        {
          "title": "自定义 OpenAI 兼容 LLM",
          "value": "custom-llm"
        },
        {
          "title": "不启用兜底",
          "value": "none"
        }
      ],
      "desc": "未登录、Credits 不足或返回 403/2001 时自动切换兜底引擎。"
    },
    {
      "identifier": "customLlmUrl",
      "type": "text",
      "title": "自定义 LLM 地址",
      "desc": "仅使用自定义 LLM 时填写（OpenAI 兼容地址）。",
      "textConfig": {
        "type": "visible",
        "placeholderText": "https://api.openai.com/v1/chat/completions"
      }
    },
    {
      "identifier": "customLlmKey",
      "type": "text",
      "title": "自定义 LLM Key",
      "desc": "仅使用自定义 LLM 时填写（仅本地使用）。",
      "textConfig": {
        "type": "secure",
        "placeholderText": "sk-..."
      }
    },
    {
      "identifier": "customLlmModel",
      "type": "text",
      "title": "自定义 LLM 模型",
      "desc": "如 gpt-4o-mini、deepseek-chat。",
      "textConfig": {
        "type": "visible",
        "placeholderText": "gpt-4o-mini"
      }
    },
    {
      "identifier": "loginMethod",
      "type": "menu",
      "title": "登录方式",
      "defaultValue": "code",
      "menuValues": [
        {
          "title": "邮箱验证码登录",
          "value": "code"
        },
        {
          "title": "邮箱密码登录",
          "value": "password"
        },
        {
          "title": "Token 直连",
          "value": "token"
        },
        {
          "title": "仅查词（不登录）",
          "value": "guest"
        }
      ],
      "desc": "登录区紧邻下方「验证」按钮；免登录仅支持全词本查词与兜底翻译。"
    },
    {
      "identifier": "token",
      "type": "text",
      "title": "Relingo Token",
      "desc": "仅「Token 直连」填写（x-relingo-token）。",
      "textConfig": {
        "type": "secure",
        "placeholderText": "x-relingo-token"
      }
    },
    {
      "identifier": "password",
      "type": "text",
      "title": "登录密码",
      "desc": "仅「邮箱密码登录」填写，仅用于换取 Token，不落盘。",
      "textConfig": {
        "type": "secure",
        "placeholderText": "Relingo 账号密码"
      }
    },
    {
      "identifier": "email",
      "type": "text",
      "title": "邮箱",
      "desc": "验证码登录：填邮箱点下方「验证」发码；密码登录：填邮箱与密码点「验证」。",
      "textConfig": {
        "type": "visible",
        "placeholderText": "example@mail.com"
      }
    },
    {
      "identifier": "mailCode",
      "type": "text",
      "title": "邮箱验证码",
      "desc": "收到验证码后填入此处，再点下方「验证」完成登录。",
      "textConfig": {
        "type": "visible",
        "placeholderText": "114514"
      }
    }
  ]
}
